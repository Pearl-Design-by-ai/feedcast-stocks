{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedcast-stocks",
  "main": "worker-wrapper.mjs",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  // Production domains. Cloudflare provisions SSL via DNS-01 once each
  // hostname resolves through the feedcast.news zone. Until then the
  // workers.dev fallback URL keeps serving.
  //
  // `markets` is the canonical domain (rebranded from `stocks`).
  // `stocks` stays bound so middleware can 301 it to `markets`.
  "routes": [
    {
      "pattern": "markets.feedcast.news",
      "custom_domain": true
    },
    {
      "pattern": "stocks.feedcast.news",
      "custom_domain": true
    }
  ]
}
