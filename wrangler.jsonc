{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedcast-stocks",
  "main": "worker-wrapper.mjs",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  // Production domains. Cloudflare provisions SSL via DNS-01 and binds each
  // hostname directly to this Worker (custom domains, so no origin / no 522).
  "routes": [
    {
      "pattern": "stocks.feedcast.news",
      "custom_domain": true
    },
    {
      "pattern": "markets.feedcast.news",
      "custom_domain": true
    }
  ]
}
