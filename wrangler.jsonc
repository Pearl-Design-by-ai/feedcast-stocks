{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedcast-stocks",
  "main": "worker-wrapper.mjs",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Cross-isolate cache for Finnhub responses (quotes 30s, profiles 24h, …).
  // Module-level Maps don't survive Worker isolate churn, so without this the
  // free-tier rate limit (60/min) burns on re-fetching the same symbols.
  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "231d7258c4d94abc9e3f492fb5105a07"
    }
  ],
  "limits": {
    "cpu_ms": 300000
  },
  // Production domains. Cloudflare provisions SSL via DNS-01 and binds each
  // hostname directly to this Worker (custom domains, so no origin / no 522).
  "routes": [
    {
      "pattern": "stocks.feedcast.news",
      "custom_domain": true
    },
    {
      "pattern": "markets.feedcast.news",
      "custom_domain": true
    }
  ]
}
