{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "feedcast-stocks-cron",
  "main": "index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_URL": "https://stocks.feedcast.news"
  }
}
