# Feedcast Stocks — environment variables
# Copy to `.env.local` and fill in the values: `cp .env.example .env.local`

# --- Supabase (shared Feedcast project) -------------------------------------
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by the cron alert checker and admin lookups. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data ------------------------------------------------------------
# Finnhub API key (server-only). https://finnhub.io/dashboard
FINNHUB_API_KEY=

# --- Cron -------------------------------------------------------------------
# Bearer secret the cron Worker sends to POST /api/cron/check-alerts.
CRON_SECRET=

# --- Markets health bridge --------------------------------------------------
# Shared bearer secret the FeedCast (news) system monitor presents to
# GET/POST /api/health/markets so markets-data freshness lands in FeedCast's
# ops health email and its auto-fix can rebuild a stale valuation screen. Set
# the SAME value here and as MARKETS_HEALTH_SECRET on the FeedCast app. Leave
# blank to keep the bridge closed (returns 401).
MARKETS_HEALTH_SECRET=

# --- Alert emails (Feedcast email service) ----------------------------------
# When a price alert triggers, the cron POSTs a `stock_alert` template-render
# request to Feedcast's transactional email endpoint. Leave both blank to
# disable alert emails (alerts still trigger, they just won't email).
FEEDCAST_EMAIL_ENDPOINT=
FEEDCAST_EMAIL_SECRET=

# --- Adanos sentiment (optional) --------------------------------------------
# Leave blank to hide the stock sentiment card.
ADANOS_API_KEY=
ADANOS_API_BASE_URL=https://api.adanos.org

# --- Markets engine (PRIVATE analysis service) ------------------------------
# The AI/regime/divergence features proxy to a separate, closed-source Worker
# (see ./markets-engine). Leave both blank to disable those features (the rest
# of the app works). DEEPSEEK_API_KEY now lives on the engine, not here.
MARKETS_ENGINE_URL=
MARKETS_ENGINE_TOKEN=
